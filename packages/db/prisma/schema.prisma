// SavdoIQ — ma'lumotlar bazasi sxemasi
// Provider SQLite (dev) va PostgreSQL (prod) uchun mos: enum/Json/array ishlatilmaydi.
// PostgreSQL'ga o'tish: `npm run db:use-postgres`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Foydalanuvchi & Auth ───────────────────────────

model User {
  id           String    @id @default(cuid())
  telegramId   String    @unique
  username     String?
  firstName    String?
  lastName     String?
  photoUrl     String?
  phone        String?
  languageCode String    @default("uz")
  role         String    @default("user")
  status       String    @default("active")
  referralCode String    @unique
  referredById String?
  timezone     String    @default("Asia/Tashkent")
  botChatId    String?
  notifyDaily  Boolean   @default(true)
  notifyOrders Boolean   @default(true)
  notifyStock  Boolean   @default(true)
  /// Haftalik (dushanba) va oylik (oyning 1-kuni) Telegram hisoboti
  notifyWeekly  Boolean  @default(true)
  notifyMonthly Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  referredBy      User?           @relation("Referrals", fields: [referredById], references: [id])
  referrals       User[]          @relation("Referrals")
  memberships     Membership[]
  sessions        Session[]
  loginCodes      LoginCode[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  referralBonuses ReferralBonus[] @relation("BonusReferrer")
  supportTickets  SupportTicket[]

  @@index([referredById])
  @@index([botChatId])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Botdan olinadigan bir martalik kod / havola (saytga kirish uchun)
model LoginCode {
  id         String    @id @default(cuid())
  code       String    @unique
  telegramId String?
  userId     String?
  purpose    String    @default("login")
  status     String    @default("pending")
  ip         String?
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([telegramId])
}

// ─────────────────────────── Kompaniya & a'zolik ───────────────────────────

model Company {
  id          String   @id @default(cuid())
  name        String
  taxRate     Float    @default(1)
  currency    String   @default("UZS")
  onboarded   Boolean  @default(false)
  onboardStep String   @default("company")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships     Membership[]
  stores          Store[]
  uzumAccounts    UzumAccount[]
  subscription    Subscription?
  invoices        Invoice[]
  syncJobs        SyncJob[]
  expenses        Expense[]
  shipments       Shipment[]
  settings        CompanySetting[]
  scenarios       UnitScenario[]
  referralBonuses ReferralBonus[]
  purchaseBatches PurchaseBatch[]
  invites          Invite[]
  competitorPrices CompetitorPrice[]
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  role      String   @default("owner")
  /// Ko'rinish shabloni: null — rolga ko'ra hammasi; "warehouse" (omborchi),
  /// "accountant" (buxgalter), "marketer" (marketolog). Egasiga qo'yilmaydi.
  view      String?
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
}

model CompanySetting {
  id        String   @id @default(cuid())
  companyId String
  key       String
  value     String
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, key])
}

// ─────────────────────────── Uzum kabinet & do'kon ───────────────────────────

/// Uzum seller kabineti — API kalitlari shifrlangan holda saqlanadi
model UzumAccount {
  id            String    @id @default(cuid())
  companyId     String
  label         String    @default("Uzum kabinet")
  apiKeyEnc     String
  apiSecretEnc  String?
  keyHint       String?
  status        String    @default("pending")
  lastError     String?
  lastSyncAt    DateTime?
  nextSyncAt    DateTime?
  syncIntervalM Int       @default(30)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stores   Store[]
  syncJobs SyncJob[]

  @@index([companyId])
}

model Store {
  id            String   @id @default(cuid())
  companyId     String
  uzumAccountId String?
  uzumShopId    String?
  title         String
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  uzumAccount UzumAccount?    @relation(fields: [uzumAccountId], references: [id], onDelete: SetNull)
  products    Product[]
  skus        Sku[]
  orders      Order[]
  stocks      StockSnapshot[]
  reviews     Review[]
  losses      LossRecord[]
  returns     ReturnRecord[]
  storageFees StorageFee[]
  expenses    Expense[]
  shipments   Shipment[]
  payouts     PayoutRecord[]

  @@unique([companyId, uzumShopId])
  @@index([companyId])
}

// ─────────────────────────── Tarif & to'lov ───────────────────────────

model Subscription {
  id         String    @id @default(cuid())
  companyId  String    @unique
  plan       String    @default("trial")
  status     String    @default("active")
  startedAt  DateTime  @default(now())
  expiresAt  DateTime
  autoRenew  Boolean   @default(false)
  trialUsed  Boolean   @default(true)
  canceledAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Invoice {
  id         String    @id @default(cuid())
  companyId  String
  plan       String
  months     Int       @default(1)
  amount     Float
  currency   String    @default("UZS")
  provider   String    @default("manual")
  status     String    @default("pending")
  externalId String?
  payUrl     String?
  paidAt     DateTime?
  bonusUsed  Float     @default(0)
  comment    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  referralBonus ReferralBonus[]

  @@index([companyId])
  @@index([status])
}

model ReferralBonus {
  id         String   @id @default(cuid())
  referrerId String
  companyId  String
  invoiceId  String?
  amount     Float
  percent    Float    @default(20)
  status     String   @default("pending")
  createdAt  DateTime @default(now())

  referrer User     @relation("BonusReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice  Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([referrerId])
}

// ─────────────────────────── Sinxronizatsiya ───────────────────────────

model SyncJob {
  id            String    @id @default(cuid())
  companyId     String
  uzumAccountId String?
  type          String    @default("full")
  status        String    @default("queued")
  progress      Int       @default(0)
  step          String    @default("queued")
  stepIndex     Int       @default(0)
  totalSteps    Int       @default(8)
  message       String?
  error         String?
  attempts      Int       @default(0)
  scheduledAt   DateTime  @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?
  etaSeconds    Int       @default(1800)
  payload       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  uzumAccount UzumAccount? @relation(fields: [uzumAccountId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt])
  @@index([companyId])
}

// ─────────────────────────── Katalog ───────────────────────────

model Product {
  id            String   @id @default(cuid())
  storeId       String
  uzumProductId String?
  title         String
  category      String?
  brand         String?
  imageUrl      String?
  status        String   @default("active")
  rating        Float    @default(0)
  reviewsCount  Int      @default(0)
  /// Sotuvchi SavdoIQ'da "o'chirgan" (Uzum'da faqat arxivlash mumkin). Faqat
  /// arxivdagi tovarda amal qiladi — Uzum'da qayta faollashsa ro'yxatga qaytadi
  hidden        Boolean  @default(false)
  hiddenAt      DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  store        Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  skus         Sku[]
  reviews      Review[]
  cardContents CardContent[]
  cardKeywords CardKeyword[]
  cardDrafts   CardDraft[]
  competitorPrices CompetitorPrice[]

  @@unique([storeId, uzumProductId])
  @@index([storeId])
}

// ─────────────────────────── Kartochka SEO ───────────────────────────

/// Kartochka matni tillar bo'yicha. Seller API faqat bitta tildagi nomni beradi —
/// tavsif va ikkinchi til nomini sotuvchi o'zi joylaydi (yoki qoralamadan qo'llanadi)
model CardContent {
  id              String   @id @default(cuid())
  productId       String
  /// ru | uz
  lang            String
  title           String   @default("")
  descriptionHtml String   @default("")
  /// manual — sotuvchi joylagan · draft — qo'llangan qoralamadan
  source          String   @default("manual")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, lang])
}

/// Kartochka kalit so'zi. Talab (ko'rishlar) faqat sotuvchi import qilgan bo'lsa —
/// Uzum'da rasmiy ochiq chastota manbasi yo'q, biz uni o'ylab topmaymiz
model CardKeyword {
  id        String   @id @default(cuid())
  productId String
  /// normallashtirilgan (kichik harf, apostrof bir xil)
  text      String
  demand    Int?
  /// seller — qo'lda · auto — kod taklifi · import — jadvaldan
  source    String   @default("seller")
  /// active | excluded
  status    String   @default("active")
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, text])
  @@index([productId])
}

/// Yangi matn qoralamasi (bepul AI chatbot javobidan yoki qo'lda). Uzum'ga
/// avtomatik yozilmaydi: sotuvchi kabinetga o'zi qo'yadi va "qo'ydim" deb belgilaydi
model CardDraft {
  id              String    @id @default(cuid())
  productId       String
  lang            String
  title           String    @default("")
  descriptionHtml String    @default("")
  /// JSON massiv (qisqa afzalliklar)
  usp             String    @default("[]")
  /// ai_chat | manual
  source          String    @default("ai_chat")
  /// draft | applied
  status          String    @default("draft")
  scoreBefore     Int?
  scoreAfter      Int?
  createdById     String?
  appliedAt       DateTime?
  createdAt       DateTime  @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
}

model Sku {
  id            String   @id @default(cuid())
  productId     String
  storeId       String
  uzumSkuId     String?
  sku           String
  barcode       String?
  title         String
  imageUrl      String?
  price         Float    @default(0)
  oldPrice      Float    @default(0)
  purchasePrice Float    @default(0)
  extraCost     Float    @default(0)
  weightGr      Float    @default(0)
  volumeL       Float    @default(0)
  // Uzum katalogidagi shu SKU uchun komissiya foizi (masalan 15)
  commissionPct Float    @default(0)
  // Uzum hisoblagan bir dona uchun oylik saqlash to'lovi (paidStoragePriceItem)
  storagePerItem Float   @default(0)
  archived      Boolean  @default(false)

  // ── Aksiya (Uzum katalogidagi specialOffer) ──
  // Uzum har hafta chegirma kampaniyalari o'tkazadi va ayrim SKU'larni
  // TAKLIF qiladi. `promoOffered` — taklif bor, `promoJoined` — sotuvchi
  // qo'shilgan. `promoPrice` taklif narxi; qo'shilmagan bo'lsa AMALDAGI
  // narx emas (docs/UZUM-API.md 7.1).
  promoName     String?
  promoPrice    Float    @default(0)
  promoJoined   Boolean  @default(false)
  promoOffered  Boolean  @default(false)
  /// Aksiya qachon tugaydi (katalogdagi `specialOffer.endDate`)
  promoEndsAt   DateTime?

  // ── Kartochka holati (SKU Health) ──
  blocked       Boolean  @default(false)
  blockingReason String?
  /** Uzumning o'z statistikasi: qaytarishlar ulushi, % */
  returnedPct   Float    @default(0)
  /** Uzum omborida yaroqsiz (brak) deb belgilangan dona */
  qtyDefected   Int      @default(0)
  /** Uzum omborida yo'qolgan dona (Uzum hujjatida "eskirgan" — amalda doim 0) */
  qtyMissing    Int      @default(0)
  /// Uzumda turgan, lekin sotuvda bo'lmagan dona: qo'shimcha ombor, fotostudiya,
  /// arxiv, ishlov kutayotgan. Tovar balansida "yo'qolgan" deb sanalmasligi uchun.
  qtyElsewhere  Int      @default(0)
  /// Uzumning umrbod hisoblagichlari (quantitySold / quantityReturned) —
  /// bizdagi buyurtmalar tarixi to'liqmi, shu bilan tekshiriladi.
  uzumSold      Int      @default(0)
  uzumReturned  Int      @default(0)

  /**
   * MXIK — Mahsulot va Xizmatlar Identifikatsiya Kodi.
   *
   * O'zbekistonda har bir tovar uchun majburiy: kod noto'g'ri bo'lsa soliq
   * idorasi tovarni sotishga yo'l qo'ymaydi. Uzum katalogi uni `ikpu`
   * maydonida qaytaradi — ilgari biz uni o'qimasdan tashlab yuborardik.
   */
  ikpu          String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  store         Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderItems    OrderItem[]
  stocks        StockSnapshot[]
  costHistory   CostPrice[]
  losses        LossRecord[]
  returns       ReturnRecord[]
  storageFees   StorageFee[]
  shipmentItems ShipmentItem[]
  reviews       Review[]
  competitorPrices CompetitorPrice[]

  @@unique([storeId, sku])
  @@index([productId])
  @@index([storeId])
}

model CostPrice {
  id        String   @id @default(cuid())
  skuId     String
  value     Float
  extraCost Float    @default(0)
  fromDate  DateTime @default(now())
  note      String?
  createdAt DateTime @default(now())

  sku Sku @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@index([skuId, fromDate])
}

// ─────────────────────────── Buyurtmalar ───────────────────────────

model Order {
  id           String    @id @default(cuid())
  storeId      String
  uzumOrderId  String?
  status       String    @default("new")
  deliveryType String    @default("FBO")
  orderedAt    DateTime
  paidAt       DateTime?
  deliveredAt  DateTime?
  buyerCity    String?
  totalAmount  Float     @default(0)
  commission   Float     @default(0)
  logistics    Float     @default(0)
  discount     Float     @default(0)
  itemsCount   Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  store Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items OrderItem[]

  @@unique([storeId, uzumOrderId])
  @@index([storeId, orderedAt])
  @@index([status])
}

model OrderItem {
  id            String    @id @default(cuid())
  orderId       String
  skuId         String?
  skuCode       String?
  title         String?
  qty           Int       @default(1)
  // Qaytarilgan dona (Uzum: amountReturns) — qaytarish foizi shu maydondan
  returnedQty   Int      @default(0)
  sellPrice     Float     @default(0)
  purchasePrice Float     @default(0)
  commission    Float     @default(0)
  logistics     Float     @default(0)
  otherCost     Float     @default(0)
  revenue       Float     @default(0)
  payout        Float     @default(0)
  /// Uzum `withdrawnProfit` — shu pozitsiyadan sotuvchiga allaqachon yechib berilgan summa
  withdrawn     Float     @default(0)
  netProfit     Float     @default(0)
  status        String    @default("delivered")
  returnedAt    DateTime?
  /// Uzum `returnCause` — bekor qilish yoki qaytarish sababi (asl matni)
  returnCause   String?
  /// Pozitsiya bekor bo'lgani yoki qaytgani BIZ birinchi marta ko'rgan payt.
  /// Uzum API'da bekor qilingan sana yo'q. Tovar omborga qaytishi shu paytdan
  /// kutiladi (tovar balansi). Tarixdan bekor holatda kelgan yozuvlarda null.
  canceledAt    DateTime?
  orderedAt     DateTime

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku   Sku?  @relation(fields: [skuId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([skuId, orderedAt])
}

// ─────────────────────────── Qoldiq & ombor ───────────────────────────

model StockSnapshot {
  id        String   @id @default(cuid())
  skuId     String
  storeId   String
  date      DateTime
  fbo       Int      @default(0)
  fbs       Int      @default(0)
  own       Int      @default(0)
  reserved  Int      @default(0)
  inTransit Int      @default(0)
  createdAt DateTime @default(now())

  sku   Sku   @relation(fields: [skuId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([skuId, date])
  @@index([storeId, date])
}

model Shipment {
  id            String    @id @default(cuid())
  companyId     String
  storeId       String?
  code          String
  destination   String?
  status        String    @default("draft")
  plannedAt     DateTime?
  acceptedAt    DateTime?
  note          String?
  /// manual — saytda yaratilgan; uzum — Uzum nakladnoyidan import qilingan (faqat o'qiladi)
  source        String    @default("manual")
  /// Uzum nakladnoy id'si (source = uzum bo'lganda)
  uzumInvoiceId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  store   Store?         @relation(fields: [storeId], references: [id], onDelete: SetNull)
  items   ShipmentItem[]

  @@unique([storeId, uzumInvoiceId])
  @@index([companyId])
}

model ShipmentItem {
  id         String @id @default(cuid())
  shipmentId String
  skuId      String
  qty        Int    @default(0)
  accepted   Int    @default(0)
  boxes      Int    @default(0)

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  sku      Sku      @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
}

model LossRecord {
  id          String    @id @default(cuid())
  storeId     String
  skuId       String?
  type        String    @default("lost")
  scheme      String    @default("FBO")
  qty         Int       @default(0)
  amount      Float     @default(0)
  compensated Float     @default(0)
  status      String    @default("open")
  happenedAt  DateTime
  claimSentAt DateTime?
  note        String?
  /// Yozuv qayerdan: uzum — Uzum/namuna ma'lumoti; qolganlari SavdoIQ o'zi
  /// aniqlagan: balance (tovar balansida hisobda yo'q), counter (Uzum
  /// "yo'qolgan" hisoblagichi), defect (brak), shortage (qabulda kam chiqqan),
  /// stuck (uzoq vaqt topshirilmagan buyurtma).
  source      String    @default("uzum")
  /// Manba ichidagi kalit (SKU, nakladnoy yoki buyurtma) — qayta sinxronda
  /// o'sha yozuv yangilanishi uchun
  ref         String?
  /// Dalil (JSON matn): hisob-kitob va buyurtma raqamlari
  details     String?
  createdAt   DateTime  @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sku   Sku?  @relation(fields: [skuId], references: [id], onDelete: SetNull)

  @@index([storeId, happenedAt])
  @@index([storeId, source])
}

model ReturnRecord {
  id         String   @id @default(cuid())
  storeId    String
  skuId      String?
  orderCode  String?
  qty        Int      @default(1)
  amount     Float    @default(0)
  reason     String?
  status     String   @default("returned")
  returnedAt DateTime
  createdAt  DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sku   Sku?  @relation(fields: [skuId], references: [id], onDelete: SetNull)

  @@index([storeId, returnedAt])
}

/// Pullik saqlash (platnoye xranenie)
model StorageFee {
  id        String   @id @default(cuid())
  storeId   String
  skuId     String?
  date      DateTime
  qty       Int      @default(0)
  volumeL   Float    @default(0)
  amount    Float    @default(0)
  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sku   Sku?  @relation(fields: [skuId], references: [id], onDelete: SetNull)

  @@index([storeId, date])
}

model Expense {
  id        String   @id @default(cuid())
  companyId String
  storeId   String?
  date      DateTime
  category  String
  amount    Float    @default(0)
  note      String?
  source    String   @default("manual")
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  store   Store?  @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([companyId, date])
}

/// Uzum sotuvchiga o'tkazgan pul (jadval bo'yicha yoki erta yechish).
/// API'da to'lovlar tarixi yo'q — sinxron `withdrawnProfit` yig'indisi oshganda yozadi.
model PayoutRecord {
  id        String   @id @default(cuid())
  storeId   String
  /// To'lov kuni (savdo mintaqasi bo'yicha)
  date      DateTime
  /// Balansdan chiqqan summa — `withdrawnProfit` o'sishi, so'm
  amount    Float
  /// Erta yechish haqi (ma'lum bo'lsa), so'm
  fee       Float    @default(0)
  /// scheduled — jadval bo'yicha · early — erta yechish · earlier — tarix yuritilishidan oldingi jami
  kind      String   @default("scheduled")
  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, date])
}

// ─────────────────────────── Sharhlar & bildirishnomalar ───────────────────────────

model Review {
  id           String    @id @default(cuid())
  storeId      String
  productId    String?
  skuId        String?
  uzumReviewId String?
  rating       Int       @default(5)
  text         String?
  author       String?
  publishedAt  DateTime
  answered     Boolean   @default(false)
  answerText   String?
  answeredAt   DateTime?
  autoAnswered Boolean   @default(false)
  createdAt    DateTime  @default(now())

  store   Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  sku     Sku?     @relation(fields: [skuId], references: [id], onDelete: SetNull)

  @@unique([storeId, uzumReviewId])
  @@index([storeId, publishedAt])
  // Kartochka va mahsulot tafsiloti sharhlarni mahsulot bo'yicha o'qiydi — indekssiz Postgres butun jadvalni ko'rib chiqardi
  @@index([productId, publishedAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String    @default("info")
  channel   String    @default("app")
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

// ─────────────────────────── Qo'llab-quvvatlash ───────────────────────────

/// Sotuvchining murojaati.
///
/// `code` — qisqa belgi (#S-7K2M): operator ham, sotuvchi ham shu bilan tilga oladi.
/// Bitta sotuvchida bir vaqtda bitta ochiq ip: 24 soat ichidagi yangi savol
/// yangi murojaat ochmaydi, o'sha ipga qo'shiladi — aks holda bitta muammo
/// uchun operatorda o'nta alohida kartochka paydo bo'lardi.
model SupportTicket {
  id            String    @id @default(cuid())
  userId        String
  code          String    @unique
  status        String    @default("open") // open | answered | closed
  subject       String    @default("") // birinchi xabarning qisqartmasi — /tickets ro'yxati uchun
  lang          String    @default("uz")
  lastMessageAt DateTime  @default(now())
  answeredAt    DateTime?
  closedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages SupportMessage[]

  @@index([status, lastMessageAt])
  @@index([userId, createdAt])
}

/// Murojaatdagi bitta xabar va AYNI PAYTDA yo'naltirish jadvali.
///
/// Operator qaysi xabarga reply qilsa, (adminChatId, adminMessageId) bo'yicha
/// murojaat topiladi. Bu bazada saqlanadi, xotirada emas: bot har deployda
/// qayta ishga tushadi va xotiradagi jadval yo'qolardi — operator javobi esa
/// ertasi kuni ham to'g'ri odamga borishi kerak.
///
/// `forwardMessage` ataylab ishlatilmaydi: sotuvchi maxfiylikni yopgan bo'lsa
/// `forward_origin` ichida uning id'si bo'lmaydi va javobni qaytarib bo'lmaydi.
model SupportMessage {
  id             String   @id @default(cuid())
  ticketId       String
  direction      String   @default("in") // in (sotuvchi → operator) | out (operator → sotuvchi)
  kind           String   @default("text") // text | photo | document | video | voice | audio
  body           String   @default("")
  authorId       String? // operator telegramId (direction = out bo'lsa)
  userChatId     String?
  userMessageId  Int?
  adminChatId    String?
  adminMessageId Int?
  createdAt      DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@index([adminChatId, adminMessageId])
}

/**
 * Soliq qo'mitasi registridan olingan MXIK yozuvi.
 *
 * tasnif.soliq.uz ochiq, kalitsiz API beradi, lekin registrda 441 mingdan
 * ortiq kod bor va to'liq nusxa olish mumkin emas (bo'sh qidiruv nol
 * qaytaradi, katta sahifa 500 beradi). Shuning uchun faqat qidirilgan
 * kodlar keshlanadi — takroriy so'rov tashqi xizmatga chiqmaydi.
 */
model MxikCache {
  code        String   @id
  name        String
  fullName    String   @default("")
  groupName   String   @default("")
  className   String   @default("")
  unitsName   String   @default("")
  fetchedAt   DateTime @default(now())

  @@index([fetchedAt])
}

model UnitScenario {
  id        String   @id @default(cuid())
  companyId String
  name      String
  data      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

/**
 * Xitoydan olingan tovar partiyasi (sotuvchining Excel jadvali o'rniga).
 * Kurs partiya uchun bir marta belgilanadi: keyin Markaziy bank kursi
 * o'zgarsa ham eski partiyaning tannarxi o'zgarmasligi kerak.
 */
model PurchaseBatch {
  id        String   @id @default(cuid())
  companyId String
  name      String
  /// 1 ¥ necha so'm
  rate      Float
  /// Partiya bo'yicha qo'shimcha xarajat, so'm
  extra     Float    @default(0)
  /// Ro'yxatdagi o'rni (kichigi yuqorida). Sotuvchi sudrab o'zgartiradi;
  /// yangi partiya eng kichik qiymatdan bittaga kam oladi — tepada chiqadi
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items     PurchaseBatchItem[]
  extras    PurchaseBatchExtra[]
  shipments PurchaseBatchShipment[]

  @@index([companyId, createdAt])
}

/// Partiyaning bitta jo'natmasi: bitta kargo va bitta yetkazish turi (avia/avto)
/// bilan ketgan tovarlar. Holat va sanalar alohida jadvalda — partiya jadvali
/// (qatorlar) har saqlanganda qayta yoziladi, bu yerdagilar esa o'chib ketmaydi.
/// Kargolarning o'rtacha yetkazish muddati shu sanalardan hisoblanadi.
model PurchaseBatchShipment {
  id        String    @id @default(cuid())
  batchId   String
  /// Kargo nomi — katta harfda, bo'sh joysiz (qatorlardagi yozilishidan qat'i nazar bitta jo'natma).
  /// Reys raqami bo'lsa unga qo'shiladi: "TEZ-TEZ#50". Alohida ustun emas — mavjud
  /// noyob kalitni o'zgartirish jonli bazada ma'lumot yo'qotish ogohlantirishi beradi
  cargoKey  String    @default("")
  /// avia | avto
  delivery  String    @default("avto")
  /// warehouse — Xitoydagi omborda | shipped — yo'lda | arrived — keldi
  status    String    @default("warehouse")
  shippedAt DateTime?
  arrivedAt DateTime?
  updatedAt DateTime  @updatedAt

  batch PurchaseBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, cargoKey, delivery])
}

/// Qo'shimcha xarajat tafsiloti (bojxona, yo'l haqi...). Yig'indisi PurchaseBatch.extra ga yoziladi
model PurchaseBatchExtra {
  id       String @id @default(cuid())
  batchId  String
  position Int    @default(0)
  /// Izoh: nima uchun to'langan
  name     String @default("")
  /// so'm
  amount   Float  @default(0)
  /// road — yo'l kira (partiyalar umumiy summasiga kiradi) | other — logistika, paket va h.k.
  /// Bo'sh — turi tanlanmasdan oldin yozilgan: nomidan aniqlanadi ("yo'l haqi" → road)
  kind     String @default("")

  batch PurchaseBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, position])
}

model PurchaseBatchItem {
  id        String @id @default(cuid())
  batchId   String
  position  Int    @default(0)
  name      String @default("")
  trackCode String @default("")
  /// Nechta dona; 0 — kiritilmagan (1 dona tannarxi hisoblanmaydi)
  qty       Int    @default(0)
  /// Shu qatorning jami narxi (barcha donalar uchun), ¥
  priceCny  Float  @default(0)
  cargoName String @default("")
  /// avia | avto
  delivery  String @default("avto")
  /// Kargo reys raqami (masalan "50"). Bir partiya bir necha reysda kelsa —
  /// har reys alohida jo'natma bo'lib kuzatiladi; bo'sh — reys ko'rsatilmagan
  trip      String @default("")
  weightKg  Float  @default(0)
  cargoCost Float  @default(0)

  batch PurchaseBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, position])
}

model AuditLog {
  id       String   @id @default(cuid())
  userId   String?
  action   String
  entity   String?
  entityId String?
  meta     String?
  ip       String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

// ─────────────────────────── Jamoa takliflari ───────────────────────────

/// Jamoaga taklif havolasi: bir martalik va muddatli. Havolaning o'zi
/// saqlanmaydi — faqat SHA-256 xeshi (Session.tokenHash kabi): baza sizib
/// chiqsa ham undan kompaniyaga kirib bo'lmaydi. Havola egasiga bir marta
/// ko'rsatiladi.
model Invite {
  id          String    @id @default(cuid())
  companyId   String
  tokenHash   String    @unique
  role        String    @default("manager")
  /// Membership.view bilan bir xil qiymatlar
  view        String?
  createdById String?
  usedById    String?
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// ─────────────────────────── Raqobatchi narxlari ───────────────────────────

/// Raqobatchi narxi — sotuvchi o'zi kiritadi. Havolani biz YUKLAMAYMIZ
/// (Uzum'ni skreyp qilmaymiz, bepul va xavfsiz), faqat saqlab, o'z narxi,
/// nol foyda narxi va marja bilan solishtiramiz.
model CompetitorPrice {
  id          String   @id @default(cuid())
  companyId   String
  productId   String
  skuId       String?
  /// Raqobatchi tovar havolasi (ixtiyoriy)
  url         String?
  /// Raqobatchi do'kon yoki tovar nomi
  title       String
  price       Float
  /// Oldingi kiritilgan narx — o'zgarish yo'nalishi uchun
  prevPrice   Float?
  /// Narx qachon tekshirilgan (sotuvchi kiritgan payt)
  checkedAt   DateTime @default(now())
  note        String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku     Sku?    @relation(fields: [skuId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([productId])
}
