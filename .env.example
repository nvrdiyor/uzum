# ───────────────────────────────────────────────────────────────
# SavdoIQ — muhit sozlamalari
# Nusxa oling: cp .env.example .env  (Windows: copy .env.example .env)
# ───────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Ma'lumotlar bazasi ────────────────────────────────────────
# SQLite (standart, hech nima o'rnatish shart emas):
DATABASE_URL="file:./dev.db"
# PostgreSQL (prod uchun — avval `npm run db:use-postgres`):
# DATABASE_URL="postgresql://user:parol@localhost:5432/savdoiq?schema=public"

# ── Server ────────────────────────────────────────────────────
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:5173
TRUST_PROXY=false

# ── Xavfsizlik ────────────────────────────────────────────────
# Kamida 32 belgi:
SESSION_SECRET=change-me-to-a-long-random-string-32chars
# 32 bayt hex (64 belgi). Yaratish: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ── Telegram bot ──────────────────────────────────────────────
# @BotFather'dan olinadi
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=savdoiq_bot
# Admin Telegram ID'lari (vergul bilan)
TELEGRAM_ADMIN_IDS=
# Webhook rejimi uchun (bo'sh bo'lsa long polling ishlatiladi)
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# ── Uzum Seller API ───────────────────────────────────────────
# demo — namunaviy ma'lumot bilan ishlaydi (API kalitsiz sinash uchun)
# live — haqiqiy Uzum API'ga ulanish
UZUM_MODE=demo
UZUM_API_BASE=https://api-seller.uzum.uz/api/seller-openapi
UZUM_TIMEOUT_MS=30000
UZUM_MAX_RETRIES=3
UZUM_RPS=3

# ── Sinxronizatsiya ───────────────────────────────────────────
SYNC_IN_PROCESS=true
SYNC_POLL_MS=3000
SYNC_CONCURRENCY=2
# 1 = haqiqiy tezlik (birinchi yig'ish ~30 daqiqa)
# 60 = tez sinov rejimi (~30 soniya) — faqat demo uchun
SYNC_SPEED_FACTOR=1

# ── To'lov tizimlari ──────────────────────────────────────────
PAYME_MERCHANT_ID=
PAYME_KEY=
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET=
# Qo'lda to'lov (karta) — botda ko'rsatiladi
MANUAL_CARD=
MANUAL_CARD_OWNER=

# ── Frontend ──────────────────────────────────────────────────
VITE_API_URL=/api/v1
VITE_BOT_USERNAME=savdoiq_bot
VITE_BRAND_NAME=SavdoIQ
